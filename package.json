{
    "name": "tanki-online-with-ki",
    "version": "1.0.5",
    "author": {
        "name": "AlanKaspersky"
    },
    "productName": "Tanki Online with KI",
    "description": "An alternative client for Tanki Online with advanced features",
    "private": true,
    "main": "./build/main.js",
    "overrides": {
        "yauzl": "^3.3.1"
    },
    "dependencies": {
        "electron-log": "5.2.4",
        "electron-squirrel-startup": "1.0.1",
        "extract-zip": "2.0.1",
        "fast-xml-parser": "4.5.0",
        "minimist": "1.2.8",
        "nodejs-file-downloader": "4.13.0",
        "update-electron-app": "3.1.0",
        "yauzl": "^3.3.1"
    },
    "devDependencies": {
        "@electron-forge/cli": "7.6.0",
        "@electron-forge/maker-deb": "7.6.0",
        "@electron-forge/maker-dmg": "7.6.0",
        "@electron-forge/maker-squirrel": "7.6.0",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/plugin-fuses": "7.6.0",
        "@electron-forge/publisher-github": "7.6.0",
        "@electron-forge/shared-types": "7.6.0",
        "@tsconfig/node22": "22.0.0",
        "@types/minimist": "1.2.5",
        "@types/node": "22.10.2",
        "electron": "44.8.0",
        "rimraf": "6.0.1",
        "ts-node": "10.9.2",
        "typescript": "5.7.2"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit --esModuleInterop --skipLibCheck --module commonjs --target es2022 forge.config.ts",
        "check": "npm run typecheck && npm test",
        "test": "node --test",
        "smoke": "node scripts/run-electron-smoke.cjs",
        "clean": "rimraf ./build",
        "prebuild": "npm run clean",
        "build": "tsc",
        "prestart": "npm run build",
        "premake": "npm run check && npm run build",
        "prepublish": "npm run check && npm run build",
        "start": "electron-forge start",
        "make": "electron-forge make",
        "make-windows": "npm run make -- --platform=win32 --arch=x64,arm64",
        "make-macos": "npm run make -- --platform=darwin --arch=x64,arm64",
        "publish": "electron-forge publish",
        "publish-windows-x64": "npm run publish -- --platform=win32 --arch=x64",
        "publish-windows-arm64": "npm run publish -- --platform=win32 --arch=arm64",
        "publish-windows": "npm run publish-windows-x64",
        "publish-macos-x64": "npm run publish -- --platform=darwin --arch=x64",
        "publish-macos-arm64": "npm run publish -- --platform=darwin --arch=arm64",
        "publish-macos": "npm run publish-macos-x64 && npm run publish-macos-arm64"
    }
}
